# Application
APP_ENV=production
APP_PORT=8080
APP_URL=https://api-audionara.rhankbrguw.xyz
ALLOWED_ORIGINS=https://audionara.rhankbrguw.xyz,https://api-audionara.rhankbrguw.xyz

# Database (PostgreSQL)
# Local: postgres | Local Host: localhost | VM/Prod: postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=audionara_user
DB_PASSWORD=your_super_secret_db_password_here
DB_NAME=audionara

# Cache & Redis (Message Broker & Cache)
# Local: redis:6379 | Local Host: localhost:6379 | VM/Prod: redis:6379
REDIS_URL=redis:6379

# Authentication (JWT Security)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY_HOURS=24

# Resend Configuration (Email Delivery & OTP Verification)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=no-reply@rhankbrguw.xyz
RESEND_FROM_NAME="AudioNara"

# SMTP Fallback (Optional - used if RESEND_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM_NAME="AudioNara"

# AI Provider (Gemini API for Recommendations & Vibes)
GEMINI_API_KEY=your_gemini_api_key_here
